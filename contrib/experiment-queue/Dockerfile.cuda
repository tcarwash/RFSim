# PyTorch 2.5.1 / CUDA 12.1 runtime for the optional DORC RFSim benchmark.
# Torch 2.5.1 supports the GTX 1080 Ti (sm_61); newer releases may not.
# Runtime is pinned to the official upstream tag for human review.
# The deployed experiment manifest must pin the immutable LOCAL image ID.
FROM pytorch/pytorch:2.5.1-cuda12.1-cudnn9-runtime@sha256:831247999fbf7e08f61b3e39f6d77ee434f38f6f07f769d00db451e853878067
ENV PYTHONUNBUFFERED=1
WORKDIR /source
RUN python -m pip install --no-cache-dir scipy==1.14.1 \
 && python -c 'import torch, numpy, scipy; assert torch.__version__.startswith("2.5.1"); print(torch.__version__, numpy.__version__, scipy.__version__)'
